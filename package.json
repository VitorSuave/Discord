    "react": "^19.2.8"
  },
  "devDependencies": {
    "@prisma/cli": "^3.0.0-beta.30",
    "@prisma/compute-sdk": "^0.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "prisma": "^6.19.3",
    "typescript": "^5.6.0"
  }
}
